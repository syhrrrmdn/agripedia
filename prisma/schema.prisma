// AgriPedia — skema database (Supabase PostgreSQL) untuk Prisma ORM 7.
// Catatan: URL koneksi TIDAK ditulis di sini, melainkan di prisma.config.ts
// (Prisma 7 memindahkan datasource url ke prisma.config.ts).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  nama         String
  role         String
  passwordHash String   @map("password_hash")
  waNumber     String   @default("") @map("wa_number")
  createdAt    DateTime @default(now()) @map("created_at")

  products Product[]
  orders   Order[]

  @@map("users")
}

model Product {
  id        String   @id @default(cuid())
  nama      String
  kategori  String   @default("Pertanian")
  harga     Int      @default(0)
  stok      Int      @default(0)
  asal      String   @default("")
  satuan    String   @default("")
  deskripsi String   @default("")
  imageUrl  String   @default("") @map("image_url")
  unggulan  Boolean  @default(false)
  penjualId Int?     @map("penjual_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  penjual User?   @relation(fields: [penjualId], references: [id], onDelete: SetNull)
  orders  Order[]

  @@index([penjualId])
  @@map("products")
}

model Order {
  id            String   @id @default(cuid())
  buyerId       Int      @map("buyer_id")
  productId     String   @map("product_id")
  jumlah        Int      @default(1)
  catatan       String   @default("")
  status        String   @default("menunggu")
  metode        String   @default("whatsapp")
  total         Int      @default(0)
  alamat        String   @default("")
  paymentStatus String   @default("unpaid") @map("payment_status")
  paymentId     String   @default("") @map("payment_id")
  snapToken     String   @default("") @map("snap_token")
  createdAt     DateTime @default(now()) @map("created_at")

  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@map("orders")
}

model Guide {
  id        String   @id @default(cuid())
  judul     String
  kategori  String   @default("Pertanian")
  tingkat   String   @default("Pemula")
  topik     String   @default("")
  ringkasan String   @default("")
  langkah   String[]
  tips      String   @default("")
  imageUrl  String   @default("") @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("guides")
}

model Setting {
  key   String @id
  value String @default("")

  @@map("settings")
}
